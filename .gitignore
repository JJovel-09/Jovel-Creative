# ============================================================
# JOVEL CREATIVE
# Deliberately conservative. The repository root is also the
# public document root, so anything ignored here is a file that
# must never be committed or is generated at deploy time.
# ============================================================

# ---------- Local environment and secret configuration ----------
.env
.env.*
!.env.example
config.local.php
*.local.php
secrets.php
credentials.php
private-config/mail-config.php

# ---------- Composer generated dependencies ----------
/vendor/

# ---------- Logs ----------
*.log
error_log
logs/

# ---------- Operating system metadata ----------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---------- Editor and temporary files ----------
*.swp
*.swo
*~
*.tmp
*.orig
.idea/
.vscode/
