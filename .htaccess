# JOVEL CREATIVE - HTACCESS CONFIGURATION
# Performance optimization, caching, compression, and security
# For Apache web servers

# ============================================
# ENABLE REWRITE ENGINE
# ============================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ============================================
  # NON-PUBLIC SOURCE AND INCLUDE PATHS
  # ============================================
  # HTTP access protection only. No routing, no redirects, no
  # canonicalization. Placed first so a request for one of these
  # paths is refused before any other rule can act on it.
  #
  # Server side PHP require() calls read from the filesystem and
  # never travel over HTTP, so the shared layout includes continue
  # to work normally. The include files also carry their own direct
  # request guard, which keeps them safe if this file is ever
  # reverted or mod_rewrite is unavailable.

  # Shared PHP layout includes.
  RewriteRule ^includes(?:/|$) - [F,L]

  # Project documentation, development material only.
  RewriteRule ^docs(?:/|$) - [F,L]

  # Markdown source anywhere in the tree. This covers README.md,
  # everything under docs/ and images/IMAGE-REQUIREMENTS.md.
  # The site serves no public .md file. Deliberately narrow: .txt is
  # NOT blocked, because assets/fonts/ibm-plex/LICENSE.txt and
  # robots.txt are both legitimately public.
  RewriteRule \.md$ - [F,L]

  # Force HTTPS (uncomment after SSL certificate is installed)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force www (choose one: www or non-www)
  # Force www version:
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # OR Force non-www version:
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ============================================
  # PUBLIC URL ROUTING
  # ============================================
  # Public content pages are served from root level PHP files and
  # exposed at extensionless URLs with no trailing slash.
  #
  #   public URL   /services
  #   source file  services.php
  #
  # Rule order below is deliberate and must be preserved:
  #
  #   1. homepage canonicalization  (before generic .php stripping)
  #   2. migrated legacy redirects  (one hop each)
  #   3. real .php request          -> clean URL   (external 301)
  #   4. trailing slash removal     (non directories only)
  #   5. clean slug                 -> .php file   (internal only)
  #
  # Rules that must not fire on Apache's own internal rewrites are
  # gated on %{THE_REQUEST}, which holds the literal client request
  # line and is never altered by mod_rewrite. Rules gated only on
  # %{REQUEST_URI} would re-trigger after an internal rewrite and
  # loop.
  #
  # MultiViews is disabled further down in this file so that content
  # negotiation cannot resolve /services on its own. That matters
  # while both services.php and the legacy services.html still exist.

  # --- 1. Homepage --------------------------------------------
  # A literal request for the homepage file canonicalizes to /.
  # The THE_REQUEST guard is required: when Apache resolves / through
  # DirectoryIndex it serves index.html internally, and a rule keyed
  # on the rewritten path would bounce / -> / forever.
  # The -f guard means this only fires for a homepage file that
  # actually exists. index.php does not exist yet; when it is added
  # this rule claims /index.php before the generic .php rule below
  # can strip it to /index.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+index\.(?:php|html)[\s?] [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^index\.(?:php|html)$ / [R=301,L]

  # --- 2. Migrated legacy URLs --------------------------------
  # Only pages whose redesigned replacement already exists belong
  # here. Legacy pages that have not been rebuilt yet are served
  # normally and must NOT be listed until their replacement ships.
  RewriteRule ^services\.html$ /services [R=301,L]
  RewriteRule ^portfolio\.html$ / [R=301,L]

  # --- 3. Exposed .php URL -> clean URL -----------------------
  # External 301 only. Conditions, in order:
  #   THE_REQUEST      the client literally asked for a .php URL, so
  #                    the internal /services -> services.php rewrite
  #                    below cannot re-enter this rule
  #   -f               the file exists, so /made-up-page.php stays a
  #                    plain 404 instead of redirecting to another 404
  # The substitution carries no query string of its own, so any
  # original query string is preserved automatically.
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/+[^\s?]*\.php[\s?] [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^([^/.]+)\.php$ /$1 [R=301,L]

  # --- 4. Trailing slash removal ------------------------------
  # Content pages carry no trailing slash. Real directories are
  # excluded by the !-d guard so /css/, /js/, /assets/ and
  # /images/ keep working. Protected paths never reach this rule,
  # they are refused above.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ /$1 [R=301,L]

  # --- 5. Clean slug -> PHP file ------------------------------
  # Internal rewrite, no redirect. The browser URL stays put and the
  # query string is carried through untouched.
  # Fires only when every one of these holds:
  #   !-f              nothing real is already at that path
  #   !-d              it is not a directory
  #   .php -f          the matching PHP file genuinely exists
  # So /services resolves, and /examples stays a 404 until
  # examples.php is actually added. Future pages start working at
  # their clean URL the moment their PHP file lands, with no change
  # to this file. Root level only by design, the site has no nested
  # content pages.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]
</IfModule>

# ============================================
# GZIP COMPRESSION
# ============================================
<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font
  AddOutputFilterByType DEFLATE application/x-font-opentype
  AddOutputFilterByType DEFLATE application/x-font-otf
  AddOutputFilterByType DEFLATE application/x-font-truetype
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml

  # Remove browser bugs (only needed for really old browsers)
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
</IfModule>

# ============================================
# BROWSER CACHING
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Default expiration: 1 hour
  ExpiresDefault "access plus 1 hour"

  # Images - 1 year
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video - 1 year
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/mpeg "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Fonts - 1 year
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS and JavaScript - 1 week
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"

  # HTML - 1 hour (so updates are seen quickly)
  ExpiresByType text/html "access plus 1 hour"

  # XML - 1 hour
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# Alternative caching with Cache-Control headers
<IfModule mod_headers.c>
  # 1 YEAR - images, fonts, videos
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|ttf|otf|woff|woff2|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # 1 WEEK - CSS and JavaScript
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>

  # 1 HOUR - HTML
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
  # X-Content-Type-Options: Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # X-Frame-Options: Prevent clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # X-XSS-Protection: Enable XSS filter in browser
  Header set X-XSS-Protection "1; mode=block"

  # Referrer-Policy: Control referrer information
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy: Control browser features
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Content Security Policy (basic - adjust as needed)
  # Uncomment and customize based on your needs
  # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com;"

  # Remove server signature
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ============================================
# BLOCK ACCESS TO SENSITIVE FILES
# ============================================
# Block access to .htaccess itself
<Files .htaccess>
  Order allow,deny
  Deny from all
</Files>

# Block access to hidden files (starting with .)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to backup and source files
<FilesMatch "\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ============================================
# DIRECTORY BROWSING AND CONTENT NEGOTIATION
# ============================================
# -Indexes     no directory listings
# -MultiViews  no content negotiation. URL resolution is owned by the
#              rewrite rules above and nothing else. Without this,
#              Apache could answer /services by negotiating between
#              services.php and the legacy services.html on its own,
#              which would both bypass our routing and make the
#              answer depend on which legacy files still exist.
# Kept as one directive. A second Options line would replace this
# one for the directory rather than add to it.
Options -Indexes -MultiViews

# ============================================
# DEFAULT DOCUMENT
# ============================================
DirectoryIndex index.html index.htm

# ============================================
# ERROR PAGES (optional - create custom error pages)
# ============================================
# ErrorDocument 404 /404.html
# ErrorDocument 403 /403.html
# ErrorDocument 500 /500.html

# ============================================
# PROTECT AGAINST CODE INJECTION
# ============================================
<IfModule mod_rewrite.c>
  # Block access to PHP files (if you're not using PHP)
  # RewriteCond %{REQUEST_URI} \.php$ [NC]
  # RewriteRule .* - [F,L]

  # Block suspicious query strings
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} GLOBALS(=|[|%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} _REQUEST(=|[|%[0-9A-Z]{0,2})
  RewriteRule .* - [F,L]
</IfModule>

# ============================================
# UTF-8 ENCODING
# ============================================
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .json .rss .atom
</IfModule>

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Enable if you need to load resources from other domains
# <IfModule mod_headers.c>
#   <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js)$">
#     Header set Access-Control-Allow-Origin "*"
#   </FilesMatch>
# </IfModule>

# ============================================
# NOTES:
# ============================================
# 1. Test your site after uploading this file
# 2. If you get a 500 Internal Server Error, some directives may not be supported
#    Comment out sections one by one to find the issue
# 3. Backup this file before making changes
# 4. Some shared hosting providers may not allow all directives
